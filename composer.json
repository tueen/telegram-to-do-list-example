{
    "name": "tueen/telegram-to-do-list-example",
    "description": "Telegram To-Do List Bot Example using Tueen Telegram SDK and Tueen Database",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.4",
        "tueen/telegram": "1.0.0-alpha.5",
        "tueen/database": "1.0.0-alpha.1"
    },
    "autoload": {
        "psr-4": {
            "Tueen\\Telegram\\Example\\ToDoList\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tueen\\Telegram\\Example\\ToDoList\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit"
    }
}
