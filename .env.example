# Telegram Bot API Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_SECRET_TOKEN=optional_secret_token_here
TELEGRAM_WEBHOOK_URL=https://your-domain.com/index.php

# Running Mode: auto, polling, or webhook
BOT_RUNNING_MODE=auto

# Database Configuration (SQLite by default)
DB_DRIVER=pdo_sqlite
DB_PATH=storage/database.sqlite

# Optional: MySQL Configuration (for shared hosting or external MySQL)
# DB_DRIVER=pdo_mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=cpaneluser_todobot
# DB_USER=cpaneluser_botuser
# DB_PASSWORD=secret_password

# Default User Timezone
APP_DEFAULT_TIMEZONE=Asia/Tehran

# Debug Mode
APP_DEBUG=true

# Web Setup / Admin Authentication
SETUP_PASSWORD=admin
